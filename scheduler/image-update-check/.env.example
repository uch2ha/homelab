# Container runtime: docker or podman
CMD=docker
# Server name for ntfy message identification
SERVER_NAME=server
# ntfy configuration
NTFY_BASE_URL=https://xxx.ntfy.xxx
NTFY_TOPIC_CRITICAL=critical-topic
NTFY_TOPIC_INFO=info-topic
# ntfy priorities: 5=urgent, 4=high, 3=default, 2=low, 1=min
NTFY_CRITICAL_PRIORITY=5
NTFY_INFO_PRIORITY=3
NTFY_ERROR_PRIORITY=5
# Comma-separated list of container names to treat as critical
# Everything else running is treated as info/non-critical
CRITICAL_CONTAINERS=vaultwarden
